# Normalizar saltos de línea automáticamente
* text=auto

# HTML / CSS / JS / JSX → LF en el repo
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.md   text eol=lf
*.json text eol=lf

# Imágenes → binario (sin conversión)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  text eol=lf
*.ico  binary
*.pdf  binary
